# Oracle Net service names (TNS). Oracle-specific connection descriptor format.
# The Snowflake migration removes this file entirely (Snowflake uses a URL/account
# identifier, no TNS). Kept here to illustrate what must be decommissioned.

HRTFD_PROD =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = ora-prod.hartford.internal)(PORT = 1521))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = HRTFD.hartford.internal)
    )
  )

HRTFD_DR =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = ora-dr.hartford.internal)(PORT = 1521))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = HRTFD_DR.hartford.internal)
    )
  )
